# Development defaults
PORT=3000
ORDEM_API_URL=http://127.0.0.1:3000

# Optional runtime tuning
# DATABASE_PATH=storage/development.sqlite3
# ORDEM_LOG_LEVEL=info
# ORDEM_ALLOWED_HOSTS=ordem.example.com
# ORDEM_DISABLE_JOB_WORKER=1
# ORDEM_HOST=0.0.0.0

# Keep state outside the repository (database in $ORDEM_HOME/dev or /userdata)
# ORDEM_HOME=~/.ordem
# ORDEM_STATE_DIR=
# ORDEM_PUBLIC_DIR=public
# ORDEM_MIGRATIONS_DIR=backend/drizzle
# ORDEM_MODE=server

# Require a bearer token on /api and ?token= on /ws (the CLI sends ORDEM_API_TOKEN)
# ORDEM_DESKTOP_TOKEN=
# ORDEM_API_TOKEN=

# Optional model overrides used by some review clients
# ANTHROPIC_MODEL=claude
# CLAUDE_MODEL=claude
