#!/usr/bin/env sh
# Installs dependencies and prepares the database. Pass --skip-server to stop
# before starting the dev servers.
set -e
cd "$(dirname "$0")/.."

echo "== Installing dependencies =="
bun install --cwd backend
npm --prefix frontend install

echo "\n== Preparing database =="
bun backend/bin/migrate.ts

case " $* " in
  *" --skip-server "*) ;;
  *)
    echo "\n== Starting development server =="
    exec bin/dev
    ;;
esac
