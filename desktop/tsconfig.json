{
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "bun"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "@shared/*": ["../shared/*"] }
  },
  "include": ["src", "scripts", "test", "electron-builder.config.ts", "../shared"]
}
