{
  "name": "ordem",
  "version": "1.0.0",
  "description": "Local-first app for automated GitHub PR reviews using external CLI agents (Bun API + React).",
  "homepage": "https://ordem.sh",
  "scripts": {
    "dev": "bin/dev",
    "setup": "bin/setup",
    "test": "bun run --cwd backend test && npm --prefix frontend run test",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend run test",
    "frontend:test:coverage": "npm --prefix frontend run test:coverage",
    "backend:dev": "bun run --cwd backend dev",
    "backend:test": "bun run --cwd backend test",
    "backend:typecheck": "bun run --cwd backend typecheck",
    "server:build": "bun scripts/build-server.ts",
    "server:smoke": "bun scripts/smoke-server.ts",
    "scripts:typecheck": "backend/node_modules/.bin/tsc -p scripts --noEmit",
    "scripts:test": "bun test ./scripts",
    "desktop:dev": "bin/dev-desktop",
    "desktop:build": "bun desktop/scripts/build.ts",
    "desktop:test": "bun test ./desktop/test",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "desktop:icons": "bun desktop/scripts/icons.ts",
    "desktop:smoke": "bun desktop/scripts/smoke.ts",
    "dist:mac": "bun desktop/scripts/dist.ts --mac --arch arm64",
    "dist:mac:x64": "bun desktop/scripts/dist.ts --mac --arch x64",
    "dist:linux": "bun desktop/scripts/dist.ts --linux --arch x64",
    "dist:linux:arm64": "bun desktop/scripts/dist.ts --linux --arch arm64",
    "dist:win": "bun desktop/scripts/dist.ts --win --arch x64"
  },
  "keywords": [],
  "author": "",
  "license": "MIT"
}
